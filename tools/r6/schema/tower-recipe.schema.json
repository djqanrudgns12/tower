{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R6 타워 진화 레시피 초안",
  "type": "object",
  "additionalProperties": false,
  "required": ["towerId", "stages"],
  "properties": {
    "towerId": { "enum": ["rail", "mortar", "cryo", "prism", "hangar", "bastion"] },
    "stages": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": false,
      "prefixItems": [
        { "$ref": "#/$defs/stage", "properties": { "level": { "const": 1 }, "tier": { "const": 1 } } },
        { "$ref": "#/$defs/stage", "properties": { "level": { "const": 2 }, "tier": { "const": 1 } } },
        { "$ref": "#/$defs/stage", "properties": { "level": { "const": 4 }, "tier": { "const": 1 } } },
        { "$ref": "#/$defs/stage", "properties": { "level": { "const": 6 }, "tier": { "const": 2 } } },
        { "$ref": "#/$defs/stage", "properties": { "level": { "const": 8 }, "tier": { "const": 2 } } },
        { "$ref": "#/$defs/stage", "properties": { "level": { "const": 10 }, "tier": { "const": 2 } } },
        { "$ref": "#/$defs/stage", "properties": { "level": { "const": 12 }, "tier": { "const": 3 } } },
        { "$ref": "#/$defs/stage", "properties": { "level": { "const": 14 }, "tier": { "const": 3 } } },
        { "$ref": "#/$defs/stage", "properties": { "level": { "const": 16 }, "tier": { "const": 3 } } },
        { "$ref": "#/$defs/stage", "properties": { "level": { "const": 18 }, "tier": { "const": 4 } } },
        { "$ref": "#/$defs/stage", "properties": { "level": { "const": 20 }, "tier": { "const": 4 } } }
      ]
    }
  },
  "$defs": {
    "partId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "parts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/partId" } },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "tier", "materialStage", "weaponStage", "slots", "attack"],
      "properties": {
        "level": { "type": "integer" },
        "tier": { "type": "integer", "minimum": 1, "maximum": 4 },
        "materialStage": { "enum": ["steel", "alloy", "ceramic", "gold-trim"] },
        "weaponStage": { "type": "integer", "minimum": 1, "maximum": 4 },
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "body", "head", "weapon"],
          "properties": {
            "base": { "$ref": "#/$defs/parts" },
            "body": { "$ref": "#/$defs/parts" },
            "armor": { "$ref": "#/$defs/parts" },
            "head": { "$ref": "#/$defs/parts" },
            "weapon": { "$ref": "#/$defs/parts" },
            "detail": { "$ref": "#/$defs/parts" },
            "marking": { "$ref": "#/$defs/parts" }
          }
        },
        "attack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "fps", "frames", "targetCount", "burstCount", "pierceCount", "recoil"],
          "properties": {
            "mode": { "enum": ["hitscan", "lob", "pulse", "chain", "drone", "barrier"] },
            "fps": { "type": "integer", "minimum": 1, "maximum": 60 },
            "frames": { "type": "integer", "minimum": 6, "maximum": 10 },
            "targetCount": { "type": "integer", "minimum": 1 },
            "burstCount": { "type": "integer", "minimum": 1 },
            "pierceCount": { "type": "integer", "minimum": 0 },
            "recoil": { "type": "number", "minimum": 0 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "tier": { "const": 1 } } }, "then": { "properties": { "materialStage": { "const": "steel" }, "weaponStage": { "const": 1 } } } },
        { "if": { "properties": { "tier": { "const": 2 } } }, "then": { "properties": { "materialStage": { "const": "alloy" }, "weaponStage": { "const": 2 } } } },
        { "if": { "properties": { "tier": { "const": 3 } } }, "then": { "properties": { "materialStage": { "const": "ceramic" }, "weaponStage": { "const": 3 } } } },
        { "if": { "properties": { "tier": { "const": 4 } } }, "then": { "properties": { "materialStage": { "const": "gold-trim" }, "weaponStage": { "const": 4 } } } }
      ]
    }
  }
}
