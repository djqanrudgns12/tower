{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R6 몬스터 개체 초안",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "species", "lineage", "tier", "rig", "skin", "animations"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "species": { "enum": ["elf", "human", "machine", "insect", "stone"] },
    "lineage": { "enum": ["infantry", "runner", "armored", "special", "boss"] },
    "tier": { "type": "integer", "minimum": 1, "maximum": 4 },
    "rig": { "$ref": "#/$defs/id" },
    "skin": { "enum": ["T1", "T2", "T3", "T4", "boss"] },
    "animations": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "walk" } },
        { "contains": { "const": "hit" } },
        { "contains": { "const": "fall" } }
      ]
    }
  },
  "if": { "properties": { "lineage": { "const": "boss" } } },
  "then": { "properties": {
    "skin": { "const": "boss" },
    "animations": { "minItems": 4, "maxItems": 4 }
  } },
  "else": {
    "properties": { "animations": { "minItems": 3, "maxItems": 3 } },
    "allOf": [
      { "if": { "properties": { "tier": { "const": 1 } } }, "then": { "properties": { "skin": { "const": "T1" } } } },
      { "if": { "properties": { "tier": { "const": 2 } } }, "then": { "properties": { "skin": { "const": "T2" } } } },
      { "if": { "properties": { "tier": { "const": 3 } } }, "then": { "properties": { "skin": { "const": "T3" } } } },
      { "if": { "properties": { "tier": { "const": 4 } } }, "then": { "properties": { "skin": { "const": "T4" } } } }
    ]
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
  }
}
